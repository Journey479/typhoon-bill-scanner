// =============================================================================
// code.gs.template — Apps Script (Telegram webhook) ฉบับ CLOUD RUN — เทมเพลตไม่มีความลับ
// วิธีใช้: คัดลอกเนื้อหานี้ไปวางใน Apps Script editor ของบอท แล้วเติมค่า PUT-YOUR-... ให้ครบ
//   - เมื่อมีไฟล์ใหม่เข้า Inbox จะ "ยิง" Cloud Run ให้ประมวลผลทันที (event-driven)
//   - มีคำสั่ง autorun:on / autorun:off เหมือนเวอร์ชันอื่น
// (ไฟล์จริงที่เติมค่าแล้วให้ตั้งชื่อ code.gs — ถูก .gitignore กันไว้ ไม่หลุดขึ้น repo)
// =============================================================================

// =========================
// CONFIG — อ่านจาก Script Properties (Project Settings → Script properties)
// ไม่มีความลับฝังในไฟล์นี้ -> commit ขึ้น git ได้ปลอดภัย
// ตั้งค่าครั้งแรก: เติมค่าใน setupProperties() ด้านล่างแล้วรันหนึ่งครั้ง (หรือกรอกมือในหน้า Project Settings)
// =========================
const PROPS = PropertiesService.getScriptProperties();
function cfg(key) { return PROPS.getProperty(key) || ""; }

const TELEGRAM_TOKEN       = cfg("TELEGRAM_TOKEN");
const INBOX_FOLDER_ID      = cfg("FOLDER_INBOX");
const PROCESSING_FOLDER_ID = cfg("FOLDER_PROCESSING");
const SUCCESS_FOLDER_ID    = cfg("FOLDER_SUCCESS");
const ERROR_FOLDER_ID      = cfg("FOLDER_ERROR");
const SPREADSHEET_ID       = cfg("SPREADSHEET_ID");

// --- Cloud Run: URL ของ service หลัง deploy + โทเคนกันคนนอกยิง (ต้องตรงกับ TRIGGER_TOKEN ใน env.yaml) ---
const CLOUD_RUN_URL   = cfg("CLOUD_RUN_URL");
const TRIGGER_TOKEN   = cfg("TRIGGER_TOKEN");

// ไฟล์สถานะ autorun — ต้องตรงกับ CloudRun/main.py (STATE_FOLDER_ID + AUTORUN_FILE)
const STATE_FOLDER_ID = SUCCESS_FOLDER_ID;   // เก็บใน Success เพราะ worker ไม่สแกนโฟลเดอร์นี้
const AUTORUN_FILE    = "_autorun_state.txt";
const CHATS_FILE      = "_telegram_chats.txt";   // allowlist: chat id ที่อนุมัติ (main.py broadcast เฉพาะรายชื่อนี้)
const ADMIN_CHAT_IDS  = cfg("ADMIN_CHAT_IDS");   // แอดมิน (คั่นด้วย ,) — เพิ่ม/ถอนสิทธิ์ได้ และรับ broadcast เสมอ

// =========================
// SETUP — เติมค่าจริงแล้วรันครั้งเดียวเพื่อบันทึกเข้า Script Properties (จากนั้นลบค่าออกได้)
// (หรือกรอกมือที่ Project Settings → Script properties ก็ได้ ไม่ต้องใช้ฟังก์ชันนี้)
// =========================
function setupProperties() {
  PropertiesService.getScriptProperties().setProperties({
    TELEGRAM_TOKEN:    "PUT-YOUR-TELEGRAM-BOT-TOKEN",
    FOLDER_INBOX:      "PUT-YOUR-INBOX-FOLDER-ID",
    FOLDER_PROCESSING: "PUT-YOUR-PROCESSING-FOLDER-ID",
    FOLDER_SUCCESS:    "PUT-YOUR-SUCCESS-FOLDER-ID",
    FOLDER_ERROR:      "PUT-YOUR-ERROR-FOLDER-ID",
    SPREADSHEET_ID:    "PUT-YOUR-SPREADSHEET-ID",
    CLOUD_RUN_URL:     "https://PUT-YOUR-CLOUD-RUN-URL-HERE.a.run.app",
    TRIGGER_TOKEN:     "PUT-YOUR-SHARED-SECRET-HERE",
    ADMIN_CHAT_IDS:    "PUT-YOUR-ADMIN-CHAT-ID",
  });
}

// =========================
// WEBHOOK
// =========================
function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) {
      return HtmlService.createHtmlOutput("NO_DATA");
    }

    const data = JSON.parse(e.postData.contents);
    const message = data.message;
    if (!message) {
      return HtmlService.createHtmlOutput("NO_MESSAGE");
    }

    // --- กัน Telegram ส่ง update เดิมซ้ำ ---
    const updateId = data.update_id;
    if (updateId != null) {
      const cache = CacheService.getScriptCache();
      const key = "u_" + updateId;
      if (cache.get(key)) {
        return HtmlService.createHtmlOutput("DUPLICATE");
      }
      cache.put(key, "1", 21600);
    }

    const chatId = message.chat.id;
    const rawText = (message.text || "").trim();
    const cmd = rawText.toLowerCase().replace(/^\//, "");

    // --- allowlist: เฉพาะแอดมิน/แชทที่อนุมัติเท่านั้นจึงใช้บอทได้ (กันคนนอกเห็นข้อมูลบิล) ---
    if (!isAuthorized(chatId)) {
      sendMessage(chatId,
        "⛔ แชทนี้ยังไม่ได้รับอนุญาตให้ใช้งานบอท\n" +
        "🆔 chat id ของคุณคือ: " + chatId + "\n" +
        "โปรดแจ้งแอดมินให้เพิ่มสิทธิ์ด้วยคำสั่ง:  allow " + chatId);
      return HtmlService.createHtmlOutput("UNAUTHORIZED");
    }
    if (isAdmin(chatId)) {
      ensureAllowed(chatId);   // แอดมินรับ broadcast ด้วย
      if (cmd.indexOf("allow") === 0 || cmd.indexOf("revoke") === 0) {
        handleAccessCommand(chatId, rawText);
        return HtmlService.createHtmlOutput("OK");
      }
      if (cmd === "chats") {
        sendMessage(chatId, buildChatsReport());
        return HtmlService.createHtmlOutput("OK");
      }
    }

    // --- คำสั่งควบคุม AUTORUN ---
    if (cmd === "autorun:on") {
      setAutorun("on");
      sendMessage(chatId, "🟢 เปิด autorun แล้ว — ไฟล์ใหม่จะถูกประมวลผลอัตโนมัติบน Cloud Run");
      return HtmlService.createHtmlOutput("OK");
    }
    if (cmd === "autorun:off") {
      setAutorun("off");
      sendMessage(chatId, "🔴 ปิด autorun แล้ว — Cloud Run จะข้ามการประมวลผล (ไฟล์ยังเข้า Inbox ปกติ)");
      return HtmlService.createHtmlOutput("OK");
    }
    if (cmd === "autorun" || cmd === "autorun:status") {
      sendMessage(chatId, "ℹ️ สถานะ autorun ปัจจุบัน: " + getAutorun().toUpperCase());
      return HtmlService.createHtmlOutput("OK");
    }

    // --- สั่งประมวลผลเดี๋ยวนี้ (เผื่อมีไฟล์ค้าง อยากให้รันเลยไม่ต้องอัปโหลดใหม่) ---
    // force=true → บังคับประมวลผลแม้ autorun=off + แจ้งกลับแม้ Inbox ว่าง
    if (cmd === "run" || cmd === "scan") {
      // ส่ง ack ก่อน แล้วค่อยยิง Cloud Run — เพราะ UrlFetchApp.fetch บล็อกรอจนประมวลผลเสร็จ
      // (ถ้ายิงก่อน ack จะมาทีหลังผล ✅ เสมอ)
      sendMessage(chatId, "🚀 สั่งให้ Cloud Run ประมวลผลไฟล์ใน Inbox แล้ว");
      triggerCloudRun(true);
      return HtmlService.createHtmlOutput("OK");
    }

    // --- คำสั่งสั่งงานผ่าน Telegram (เหมือนตัวเสถียร) ---
    if (cmd === "id") {
      sendMessage(chatId, "🆔 chat id ของแชตนี้คือ: " + chatId);
      return HtmlService.createHtmlOutput("OK");
    }
    if (cmd === "help" || cmd === "start") {
      sendMessage(chatId, buildHelp());
      return HtmlService.createHtmlOutput("OK");
    }
    if (cmd === "show") {
      sendMessage(chatId, buildShowReport());
      return HtmlService.createHtmlOutput("OK");
    }
    if (cmd === "sh") {
      sendMessage(chatId, "📄 Google Sheet:\n" + sheetUrl());
      return HtmlService.createHtmlOutput("OK");
    }
    if (cmd === "link") {
      sendMessage(chatId, buildLinks());
      return HtmlService.createHtmlOutput("OK");
    }
    if (cmd === "mvp") {
      const n = moveAllFiles(PROCESSING_FOLDER_ID, INBOX_FOLDER_ID);
      sendMessage(chatId, n > 0
        ? "🔄 ดึงจาก Processing กลับเข้า Inbox แล้ว " + n + " ไฟล์"
        : "✨ ไม่มีไฟล์ค้างใน Processing");
      return HtmlService.createHtmlOutput("OK");
    }
    if (cmd === "mve") {
      const np = moveAllFiles(PROCESSING_FOLDER_ID, INBOX_FOLDER_ID);
      const ne = moveAllFiles(ERROR_FOLDER_ID, INBOX_FOLDER_ID);
      sendMessage(chatId,
        "🔄 ดึงไฟล์กลับเข้า Inbox เรียบร้อย\n" +
        "⚡ Processing: " + np + " ไฟล์\n" +
        "❌ Error: " + ne + " ไฟล์\n" +
        "✅ รวม " + (np + ne) + " ไฟล์");
      return HtmlService.createHtmlOutput("OK");
    }

    let fileId = null;
    let originalName = null;

    if (message.photo) {
      const photo = message.photo[message.photo.length - 1];
      fileId = photo.file_id;
    } else if (message.document) {
      fileId = message.document.file_id;
      originalName = message.document.file_name;
    }

    if (fileId) {
      const savedName = saveFile(fileId, originalName);
      sendMessage(chatId, "✅ อัพโหลดสำเร็จ: " + savedName);
      // 🚀 มีไฟล์ใหม่เข้า Inbox -> ยิงให้ Cloud Run ประมวลผลทันที (event-driven)
      triggerCloudRun();
    } else {
      sendMessage(chatId, "⚠️ ไม่เข้าใจคำสั่ง — พิมพ์ help เพื่อดูคำสั่งทั้งหมด หรือส่งรูป/ไฟล์เพื่ออัปโหลด");
    }

    return HtmlService.createHtmlOutput("OK");
  } catch (err) {
    Logger.log(err);
    return HtmlService.createHtmlOutput("ERROR: " + err);
  }
}

// =========================
// ยิง Cloud Run ให้เริ่มประมวลผล (ไม่รอผล — กันไม่ให้ webhook ค้างจน Telegram ส่งซ้ำ)
// =========================
function triggerCloudRun(force) {
  if (!CLOUD_RUN_URL || CLOUD_RUN_URL.indexOf("PUT-YOUR") !== -1) {
    Logger.log("CLOUD_RUN_URL ยังไม่ได้ตั้งค่า — ข้ามการยิง");
    return;
  }
  try {
    let url = CLOUD_RUN_URL + "?token=" + encodeURIComponent(TRIGGER_TOKEN);
    if (force) url += "&force=1";   // คำสั่ง run/scan: บังคับประมวลผลแม้ autorun=off
    UrlFetchApp.fetch(url, {
      method: "get",
      muteHttpExceptions: true,
      // ไม่ตามผลลัพธ์ — แค่ปลุก Cloud Run พอ (ผลแจ้งกลับทาง Telegram จาก main.py เอง)
      followRedirects: true,
    });
  } catch (err) {
    Logger.log("triggerCloudRun error: " + err);
  }
}

// =========================
// AUTORUN STATE (เขียน/อ่านไฟล์สถานะบน Drive ให้ Cloud Run ใช้)
// =========================
function setAutorun(state) {
  const folder = DriveApp.getFolderById(STATE_FOLDER_ID);
  const old = folder.getFilesByName(AUTORUN_FILE);
  while (old.hasNext()) old.next().setTrashed(true);
  folder.createFile(AUTORUN_FILE, state, MimeType.PLAIN_TEXT);
}

// =========================
// TELEGRAM ALLOWLIST — เฉพาะแอดมิน/แชทที่อนุมัติเท่านั้นใช้บอท + รับ broadcast (กันข้อมูลบิลรั่ว)
// _telegram_chats.txt = รายชื่อ chat id ที่อนุมัติ (main.py อ่านไป broadcast)
// =========================
function getAdminIds() {
  return String(ADMIN_CHAT_IDS || "").split(/[\s,]+/).filter(String);
}
function isAdmin(chatId) {
  return getAdminIds().indexOf(String(chatId)) !== -1;
}
function getAllowlist() {
  const files = DriveApp.getFolderById(STATE_FOLDER_ID).getFilesByName(CHATS_FILE);
  if (!files.hasNext()) return [];
  return files.next().getBlob().getDataAsString().split(/[\s,]+/).filter(String);
}
function isAuthorized(chatId) {
  const id = String(chatId);
  return isAdmin(id) || getAllowlist().indexOf(id) !== -1;
}
function setAllowlist(list) {
  const content = Array.from(new Set(list.filter(String))).join("\n");
  const folder = DriveApp.getFolderById(STATE_FOLDER_ID);
  const files = folder.getFilesByName(CHATS_FILE);
  if (files.hasNext()) files.next().setContent(content);
  else folder.createFile(CHATS_FILE, content, MimeType.PLAIN_TEXT);
}
function ensureAllowed(chatId) {
  const id = String(chatId);
  const list = getAllowlist();
  if (list.indexOf(id) === -1) { list.push(id); setAllowlist(list); }
}
function handleAccessCommand(adminChatId, rawText) {
  const parts = rawText.replace(/^\//, "").split(/\s+/);
  const action = (parts[0] || "").toLowerCase();
  const target = (parts[1] || "").trim();
  if (!/^-?\d+$/.test(target)) {
    sendMessage(adminChatId, "ℹ️ ใช้:  " + action + " <chat id>\nเช่น  " + action + " 123456789");
    return;
  }
  let list = getAllowlist();
  if (action === "allow") {
    if (list.indexOf(target) === -1) list.push(target);
    setAllowlist(list);
    sendMessage(adminChatId, "✅ อนุมัติแชท " + target + " แล้ว");
    sendMessage(target, "🎉 คุณได้รับอนุญาตให้ใช้บอทแล้ว — พิมพ์ help เพื่อเริ่มต้น");
  } else {   // revoke
    setAllowlist(list.filter(function (x) { return x !== target; }));
    sendMessage(adminChatId, "🚫 ถอนสิทธิ์แชท " + target + " แล้ว");
  }
}
function buildChatsReport() {
  return "👮 แอดมิน: " + (getAdminIds().join(", ") || "-") + "\n" +
         "✅ แชทที่อนุมัติ: " + (getAllowlist().join(", ") || "-");
}

function getAutorun() {
  const folder = DriveApp.getFolderById(STATE_FOLDER_ID);
  const files = folder.getFilesByName(AUTORUN_FILE);
  if (files.hasNext()) {
    return (files.next().getBlob().getDataAsString() || "on").trim().toLowerCase();
  }
  return "on";
}

// =========================
// SAVE FILE TO DRIVE
// =========================
function saveFile(fileId, originalName) {
  const fileInfo = JSON.parse(
    UrlFetchApp.fetch(
      `https://api.telegram.org/bot${TELEGRAM_TOKEN}/getFile?file_id=${fileId}`
    ).getContentText()
  );

  const filePath = fileInfo.result.file_path;
  const downloadUrl = `https://api.telegram.org/file/bot${TELEGRAM_TOKEN}/${filePath}`;
  const blob = UrlFetchApp.fetch(downloadUrl).getBlob();

  const timestamp = Utilities.formatDate(
    new Date(),
    Session.getScriptTimeZone(),
    "yyyyMMdd_HHmmss"
  );

  let ext = "";
  const source = originalName || filePath || "";
  const dot = source.lastIndexOf(".");
  if (dot !== -1) ext = source.substring(dot);

  const name = `receipt_${timestamp}${ext}`;
  blob.setName(name);

  DriveApp.getFolderById(INBOX_FOLDER_ID).createFile(blob);
  return name;
}

// =========================
// COMMANDS (show / mvp / mve / sh / link / help)
// =========================
function countFiles(folderId) {
  const files = DriveApp.getFolderById(folderId).getFiles();
  let n = 0;
  while (files.hasNext()) { files.next(); n++; }
  return n;
}

function moveAllFiles(srcFolderId, destFolderId) {
  const dest = DriveApp.getFolderById(destFolderId);
  const files = DriveApp.getFolderById(srcFolderId).getFiles();
  let n = 0;
  while (files.hasNext()) {
    files.next().moveTo(dest);
    n++;
  }
  return n;
}

function getSuccessMonthInfo() {
  const monthStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM");
  const subs = DriveApp.getFolderById(SUCCESS_FOLDER_ID).getFoldersByName(monthStr);
  let count = 0;
  if (subs.hasNext()) {
    const files = subs.next().getFiles();
    while (files.hasNext()) { files.next(); count++; }
  }
  return { month: monthStr, count: count };
}

function sheetUrl() {
  return "https://docs.google.com/spreadsheets/d/" + SPREADSHEET_ID + "/edit";
}
function folderUrl(folderId) {
  return "https://drive.google.com/drive/folders/" + folderId;
}

function buildLinks() {
  return "🔗 ลิงก์เปิดทั้งหมด\n" +
         "📄 Sheet: " + sheetUrl() + "\n" +
         "📥 Inbox: " + folderUrl(INBOX_FOLDER_ID) + "\n" +
         "⚡ Processing: " + folderUrl(PROCESSING_FOLDER_ID) + "\n" +
         "✅ Success: " + folderUrl(SUCCESS_FOLDER_ID) + "\n" +
         "❌ Error: " + folderUrl(ERROR_FOLDER_ID);
}

function buildShowReport() {
  const s = getSuccessMonthInfo();
  return "📊 รายงานไฟล์ใน Google Drive\n" +
         "📥 Inbox: " + countFiles(INBOX_FOLDER_ID) + " ไฟล์\n" +
         "⚡ Processing: " + countFiles(PROCESSING_FOLDER_ID) + " ไฟล์\n" +
         "❌ Error: " + countFiles(ERROR_FOLDER_ID) + " ไฟล์\n" +
         "✅ Success (" + s.month + "): " + s.count + " ไฟล์";
}

function buildHelp() {
  return "📖 คำสั่งที่ใช้ได้ (ฉบับ Cloud Run):\n" +
         "📤 ส่งรูป/ไฟล์ → อัปโหลดเข้า Inbox แล้วยิง Cloud Run ประมวลผลทันที\n" +
         "🚀 run → สั่งประมวลผลไฟล์ค้างใน Inbox เดี๋ยวนี้\n" +
         "🟢 autorun:on → เปิดให้ Cloud Run ประมวลผล\n" +
         "🔴 autorun:off → ปิดการประมวลผล (ไฟล์ยังเข้า Inbox)\n" +
         "ℹ️ autorun:status → ดูสถานะ autorun ปัจจุบัน\n" +
         "🆔 id → ดูเลข chat id ของแชตนี้\n" +
         "📊 show → เช็คจำนวนไฟล์ค้าง (Inbox/Processing/Error/Success)\n" +
         "📄 sh → ลิงก์เปิด Google Sheet\n" +
         "🔗 link → ลิงก์เปิดทุกที่ (Sheet + ทุกโฟลเดอร์)\n" +
         "🔄 mvp → ดึงไฟล์จาก Processing กลับเข้า Inbox\n" +
         "🔄 mve → ดึงไฟล์จาก Error + Processing กลับเข้า Inbox\n" +
         "📖 help → แสดงคำสั่งทั้งหมด\n" +
         "— (แอดมิน) —\n" +
         "✅ allow <chat id> → อนุมัติแชทใหม่\n" +
         "🚫 revoke <chat id> → ถอนสิทธิ์แชท\n" +
         "👥 chats → ดูรายชื่อแอดมิน/แชทที่อนุมัติ";
}

// =========================
// ตอบกลับ Telegram
// =========================
function sendMessage(chatId, text) {
  UrlFetchApp.fetch(
    `https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage`,
    {
      method: "post",
      payload: { chat_id: String(chatId), text: text },
      muteHttpExceptions: true
    }
  );
}
